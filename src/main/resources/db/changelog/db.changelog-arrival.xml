<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="2" author="matasStrimaitis">
        <createTable tableName="arrival">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="arrival_details" type="VARCHAR(255)"/>
            <column name="date" type="DATE"/>
            <column name="farmer_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint
                baseTableName="arrival"
                baseColumnNames="farmer_id"
                referencedTableName="farmer"
                referencedColumnNames="id"
                constraintName="fk_arrival_farmer"/>
    </changeSet>

    <changeSet id="load-arrival-data" author="matasStrimaitis">
        <loadData tableName="arrival"
                  file="arrival.csv"
                  separator=","
                  relativeToChangelogFile="true"/>
    </changeSet>
</databaseChangeLog>